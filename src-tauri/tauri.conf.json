{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modbus Slave Studio",
  "version": "1.0.0",
  "identifier": "com.mymodbus.slave",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modbus 从机模拟器",
        "width": 1200,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Modbus TCP / RTU 从机模拟器",
    "longDescription": "一个简单易用的 Modbus TCP 与 Modbus RTU（串口）从机模拟器，可自由配置线圈、离散输入、保持寄存器和输入寄存器。"
  }
}
